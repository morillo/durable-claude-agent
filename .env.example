# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...            # required for plan/generate/summarize/judge
# Model routing: cheap steps vs. SQL generation and judging. Override freely.
MODEL_FAST=claude-haiku-4-5
MODEL_STRONG=claude-sonnet-5-5
# Server-side refusal fallback for Sonnet 5.5 (set to false to disable)
ANTHROPIC_FALLBACKS=true
LLM_EFFORT=medium                       # thinking effort for Sonnet: low|medium|high
LLM_CACHE=true                          # SQLite cache of identical requests (zero-token retries)
LLM_CACHE_PATH=./data/llm_cache.sqlite

# --- Temporal --------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=analyst

# --- MCP tool server -------------------------------------------------------
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
# Capability token: only the worker's execute_sql activity holds it. Generate with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RUN_SQL_CAPABILITY_TOKEN=replace-me

# --- Lakehouse -------------------------------------------------------------
LAKEHOUSE_PATH=./data/lakehouse
GOVERNANCE_PATH=./governance
INDEX_PATH=./data/index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_ROWS=1000                 # hard row limit on execute_sql
QUERY_TIMEOUT_SECONDS=30

# --- Observability ---------------------------------------------------------
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=durable-claude-agent
OTEL_ENABLED=true

# --- Demo hooks ------------------------------------------------------------
# DEMO_CRASH_AT=generate_sql   # kill the worker after the first tool call (crash demo)
